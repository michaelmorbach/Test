# Kopieren nach .env und eigene Werte eintragen.

# Signiert die Session-Cookies der App. Generieren z. B. via: openssl rand -base64 32
SESSION_SECRET=

# Postgres-Verbindung. Auf Vercel wird das i. d. R. automatisch gesetzt, sobald eine
# Postgres-Storage-Integration (Vercel Postgres/Neon) mit dem Projekt verknüpft ist
# (dann als POSTGRES_URL) – bei Bedarf hier zusätzlich als DATABASE_URL eintragen.
# Für lokale Entwicklung z. B.: postgresql://postgres:postgres@localhost:5432/reisekosten_dev
DATABASE_URL=
